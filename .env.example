# Copy this to .env and fill in what you need. The server runs fine with
# none of this set.

# --- MCP server ------------------------------------------------------------
# Port the Streamable HTTP transport listens on. Defaults to 127.0.0.1 --
# only widen MCP_BIND_HOST if you know you need to (see src/mcp_server.py).
MCP_SERVER_PORT=8000
# MCP_BIND_HOST=127.0.0.1
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=

# --- Hexi web demo -----------------------------------------------------
# Only needed if you hit GitHub's 60/hour unauthenticated rate limit while
# importing a repo's PR history through Hexi's "My data" tab. Never
# required for the rest of the demo, and only ever used for read-only
# GitHub API calls -- see data_adapters.py's from_github_pull_requests.
# GITHUB_TOKEN is additionally gated behind GITHUB_TOKEN_PUBLIC_DEMO_OK:
# set that to "true" only if you're comfortable with any visitor of a
# publicly-reachable deployment being able to use this token's scope.
GITHUB_TOKEN=
GITHUB_TOKEN_PUBLIC_DEMO_OK=false
WEB_PORT=5000
WEB_BIND_HOST=127.0.0.1

# --- Aspen (optional) ----------------------------------------------------
# Aspen is a separate desktop companion (github.com/aashnology/Woof). Point
# this at your checkout of it and Hexi can call him in when you say yes.
# Left empty, Hexi just says Aspen isn't set up and carries on.
ASPEN_HOME=
# ASPEN_PYTHON=

# --- Hexi's diagnostic advisor (optional) -----------------------------------
# With none of these set, diagnoses come from a built-in rule-based template.
# The numbers are always computed locally; a model only words them, and its
# reply is discarded if it contains a figure the report does not support.
# ANTHROPIC_API_KEY=
# For an OpenAI-compatible endpoint instead:
# LLM_BASE_URL=
# LLM_API_KEY=
# HEXI_LLM_MODEL=
# HEXI_LLM_PROVIDER=        # anthropic | openai-compatible | none

# --- Imported datasets --------------------------------------------------------
# Where imports are stored (shared by the web and MCP servers). Defaults to data/workspaces.
# HEXI_WORKSPACE_DIR=
