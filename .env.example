# Copy this to .env and fill in what you need. The server runs fine with
# none of this set -- Bedrock narration just falls back to a template.

# --- Bedrock narration (optional, AWS Builder mini challenge) --------------
# Set to "true" to have narrate_briefing phrase results through Bedrock
# instead of the built-in template. Requires AWS credentials available to
# boto3 (env vars, ~/.aws/credentials, or an IAM role -- never hardcode
# keys here or anywhere in the repo).
ENABLE_BEDROCK_NARRATION=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-1

# --- MCP server ------------------------------------------------------------
# Port the Streamable HTTP transport listens on inside the container.
MCP_SERVER_PORT=8000

# --- Hexi web demo -----------------------------------------------------
# Only needed if you hit GitHub's 60/hour unauthenticated rate limit while
# importing a repo's PR history through Hexi's "My data" tab. Never
# required for the rest of the demo, and only ever used for read-only
# GitHub API calls -- see data_adapters.py's from_github_pull_requests.
GITHUB_TOKEN=
WEB_PORT=5000
